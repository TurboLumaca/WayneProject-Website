---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { influences, channels } from '../data/wayne';
---

<Base title="The Archive — Project Wayne" floor="archive" theme="bruce">
  <PageHero
    floor="archive"
    eyebrow="Media pulled from while working on the project"
    title="The Archive"
    lede="Fighters, soldiers, comics, books and series that shaped the method. The full reading list lives on Goodreads."
  >
    <svg class="study-clock" viewBox="0 0 200 200" aria-hidden="true" data-clock-face>
      <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <circle cx="100" cy="100" r="86" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.5"></circle>
      {Array.from({ length: 60 }, (_, i) => <line x1="100" y1="9" x2="100" y2={i % 5 === 0 ? 22 : 15} stroke="currentColor" stroke-width={i % 5 === 0 ? 2 : 0.8} transform={`rotate(${i * 6} 100 100)`} />)}
      <g data-hand-h><line x1="100" y1="100" x2="100" y2="52" stroke="currentColor" stroke-width="5" stroke-linecap="square"></line></g>
      <g data-hand-m><line x1="100" y1="100" x2="100" y2="30" stroke="currentColor" stroke-width="3" stroke-linecap="square"></line></g>
      <circle cx="100" cy="100" r="5" fill="currentColor"></circle>
    </svg>
    <p class="study-note mono" data-pin>The study clock, set to 10:10. In the films, it is the door.</p>
  </PageHero>

  <section class="floor" id="shelf">
    <div class="wrap">
      <ul class="shelf">
        {
          influences.map((i, n) => (
            <li class="spine-card" data-reveal data-delay={(n % 4) * 0.06}>
              <span class="sc-kind mono">{i.kind}</span>
              <h2 class="serif">{i.name}</h2>
              <p>{i.why}</p>
              <span class="sc-no mono">{String(n + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="floor community" id="community">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">✉</span>
        <h2 class="serif h-lg" data-split>Join the project</h2>
        <p class="eyebrow">Where the conversation actually happens</p>
      </header>
      <ul class="chan">
        {
          channels.map((c, i) => (
            <li data-reveal data-delay={i * 0.05}>
              <a href={c.href} target="_blank" rel="noopener">
                <span class="serif">{c.name}</span>
                <span class="mono">{c.handle}</span>
                <span class="arrow mono" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="next" data-reveal>
        <a class="enter-link" href="/cases"><span class="code">B1</span> Take the stairs down to the Case Files →</a>
      </div>
    </div>
  </section>

  <section class="floor forum-link">
    <div class="wrap">
      <a class="enter-link" href="/forum"><span class="code">G</span> The Forum · what readers said back →</a>
    </div>
  </section>

  <script>
    import '../scripts/page';
    import { gsap, reduce, arrived } from '../scripts/core';
    const h = document.querySelector('[data-hand-h]');
    const m = document.querySelector('[data-hand-m]');
    if (h && m) {
      gsap.set([h, m], { transformOrigin: '100px 100px' });
      if (reduce) {
        gsap.set(h, { rotation: -60 });
        gsap.set(m, { rotation: 60 });
      } else {
        arrived.then(() => {
          gsap.fromTo(h, { rotation: 20 }, { rotation: -60, duration: 2.4, ease: 'power3.inOut', delay: 0.6 });
          gsap.fromTo(m, { rotation: 200 }, { rotation: 60, duration: 2.8, ease: 'power3.inOut', delay: 0.6 });
        });
      }
    }
  </script>
</Base>

<style>
  .study-clock {
    position: absolute;
    right: calc(var(--gutter) + var(--rail) + 10px);
    top: -8px;
    width: clamp(180px, 26vw, 380px);
    color: var(--accent);
    opacity: 0.28;
    pointer-events: none;
  }
  .study-note {
    margin: 24px 0 0;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .study-clock {
      opacity: 0.14;
      right: -40px;
    }
  }
  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .spine-card {
    position: relative;
    background: var(--bg);
    padding: 24px 22px 56px;
    min-height: 320px;
    display: grid;
    align-content: start;
    gap: 14px;
    transition: background 0.4s;
  }
  .spine-card:hover {
    background: var(--bg-2);
  }
  .sc-kind {
    justify-self: start;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid currentColor;
    padding: 3px 6px 2px;
  }
  .spine-card h2 {
    margin: 30px 0 0;
    font-size: clamp(26px, 2.4vw, 38px);
    font-weight: 400;
    line-height: 1.02;
  }
  .spine-card p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .sc-no {
    position: absolute;
    right: 18px;
    bottom: 16px;
    font-size: 11px;
    color: var(--muted);
  }
  .shelf li:last-child:nth-child(4n + 3) {
    grid-column: span 2;
  }

  .chan {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .chan a {
    display: grid;
    grid-template-columns: 1.2fr 1fr 24px;
    gap: 24px;
    align-items: baseline;
    padding: clamp(20px, 3vh, 34px) 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease-out), color 0.3s;
  }
  .chan a:hover {
    padding-left: 14px;
    color: var(--accent);
  }
  .chan .serif {
    font-size: clamp(32px, 4.4vw, 72px);
    line-height: 1;
  }
  .chan .mono {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .next {
    margin-top: clamp(48px, 8vh, 96px);
  }

  @media (max-width: 960px) {
    .shelf {
      grid-template-columns: repeat(2, 1fr);
    }
    .shelf li:last-child:nth-child(4n + 3) {
      grid-column: auto;
    }
  }
  @media (max-width: 560px) {
    .shelf {
      grid-template-columns: 1fr;
    }
    .spine-card {
      min-height: 0;
    }
    .chan a {
      grid-template-columns: 1fr 24px;
    }
    .chan .mono:nth-child(2) {
      grid-column: 1;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { phases, blueprintNote, financeGuides, research } from '../data/wayne';
---

<Base title="The Blueprint — Project Wayne" floor="blueprint" theme="bruce">
  <PageHero
    floor="blueprint"
    eyebrow="A step-by-step guide to becoming a real-life Bruce Wayne"
    title="The Blueprint"
    lede="Every step taken in his own pursuit, plus the alternative paths. Each phase has a main page, and each topic its own."
  />

  <section class="floor" id="phases">
    <div class="wrap">
      <ol class="stack">
        {
          phases.map((p) => (
            <li class="storey" data-reveal>
              <span class="storey-n display">0{p.n}</span>
              <div class="storey-main">
                <p class="eyebrow">Phase {p.n} · {p.tag}</p>
                <h2 class="serif h-lg">{p.name}</h2>
                <p class="storey-text">{p.text}</p>
                <a class="enter-link" href={p.href} target="_blank" rel="noopener">Read the full phase <span class="code">↗</span></a>
              </div>
            </li>
          ))
        }
      </ol>
      <aside class="note" data-reveal>
        <span class="mono">Update · {blueprintNote.date}</span>
        <p>{blueprintNote.text}</p>
      </aside>
    </div>
  </section>

  <section class="floor guides" id="guides">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">06</span>
        <h2 class="serif h-lg" data-split>Phase One: the finance rooms</h2>
        <p class="eyebrow">Six strategies feeding one goal, $1,250,000 by age 30</p>
      </header>
      <div class="rooms">
        {
          financeGuides.map((g, i) => (
            <a class="room" href={g.href} target="_blank" rel="noopener" data-reveal data-delay={(i % 3) * 0.08}>
              <span class="room-n mono">0{i + 1}</span>
              <h3 class="serif">{g.name}</h3>
              <p class="room-full eyebrow">{g.full}</p>
              <p class="room-text">{g.text}</p>
              <span class="room-go mono" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="floor" id="research">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">R</span>
        <h2 class="serif h-lg" data-split>Research</h2>
        <p class="eyebrow">Ideas under evaluation</p>
      </header>
      <ul class="rlist">
        {
          research.map((r) => (
            <li data-reveal>
              <a href={r.href} target="_blank" rel="noopener">
                <span class="serif">{r.name}</span>
                <span class="rl-t">{r.text}</span>
                <span class="mono">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="next" data-reveal>
        <a class="enter-link" href="/archive"><span class="code">G</span> Next floor down: the Archive →</a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/page';
  </script>
</Base>

<style>
  /* Applied Sciences: a drafting table */
  :global(.phero) {
    background-image:
      linear-gradient(color-mix(in srgb, var(--fg) 9%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--fg) 9%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: -1px -1px;
    -webkit-mask-image: none;
  }
  :global(.phero)::after {
    content: 'SCALE 1:1  ·  REV 2026';
    position: absolute;
    right: calc(var(--gutter) + var(--rail));
    bottom: 18px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .storey {
    display: grid;
    grid-template-columns: clamp(100px, 18vw, 300px) 1fr;
    gap: clamp(24px, 5vw, 80px);
    padding: clamp(40px, 8vh, 96px) 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .storey-n {
    font-size: clamp(110px, 20vw, 340px);
    line-height: 0.78;
    color: var(--accent);
  }
  .storey-main {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .storey-main h2 {
    margin: 0;
  }
  .storey-text {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(17px, 1.5vw, 22px);
    color: var(--muted);
  }
  .note {
    margin-top: 40px;
    padding: 22px 24px;
    background: var(--bg-2);
    border-left: 2px solid var(--accent);
    max-width: 780px;
  }
  .note .mono {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .note p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .rooms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .room {
    position: relative;
    background: var(--bg);
    padding: clamp(24px, 2.6vw, 40px);
    min-height: 280px;
    display: grid;
    align-content: start;
    gap: 10px;
    transition: background 0.4s;
  }
  .room:hover {
    background: var(--bg-2);
  }
  .room-n {
    font-size: 11px;
    color: var(--accent);
  }
  .room h3 {
    margin: 22px 0 0;
    font-size: clamp(34px, 3.4vw, 54px);
    font-weight: 400;
    line-height: 1;
  }
  .room-text {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 30ch;
  }
  .room-go {
    position: absolute;
    right: 22px;
    bottom: 18px;
    transition: transform 0.4s var(--ease-out), color 0.3s;
  }
  .room:hover .room-go {
    transform: translate(4px, -4px);
    color: var(--accent);
  }

  .rlist {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rlist a {
    display: grid;
    grid-template-columns: 1.2fr 1fr 24px;
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease-out), color 0.3s;
  }
  .rlist a:hover {
    padding-left: 14px;
    color: var(--accent);
  }
  .rlist .serif {
    font-size: clamp(24px, 2.8vw, 42px);
    line-height: 1.05;
  }
  .rl-t {
    color: var(--muted);
  }
  .next {
    margin-top: clamp(48px, 8vh, 96px);
  }

  @media (max-width: 860px) {
    .storey {
      grid-template-columns: 1fr;
    }
    .storey-n {
      font-size: 110px;
    }
    .rooms {
      grid-template-columns: 1fr;
    }
    .room {
      min-height: 0;
    }
    .rlist a {
      grid-template-columns: 1fr 24px;
    }
    .rl-t {
      grid-column: 1;
      grid-row: 2;
    }
  }
</style>

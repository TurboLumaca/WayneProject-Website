---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
import Skyline from '../components/Skyline.astro';
import {
  manifesto,
  manifestoLong,
  headline,
  years,
  phases,
  blueprintNote,
  influences,
  cases,
  pullups,
  running,
  caveWall,
  PROJECT_START,
} from '../data/wayne';

const keyByYear = years.map((y) => ({ ...y, key: y.items.filter((i) => i.key).map((i) => i.text) }));
const featured = [cases[0], cases.find((c) => c.no === 8)!, cases.find((c) => c.no === 11)!];
const max = Math.max(...running.months.map((m) => m[1]));
const marquee = [...influences, ...influences];
---

<Base title="Project Wayne — The tower and the cave" floor="atrium" theme="night">
  <!-- ═════════════ L42 · HERO ═════════════ -->
  <section class="hero" data-fl="atrium" data-pose="hero" data-hero style="--lx: 50%;">
    <canvas class="hero-gl" data-hero-gl aria-hidden="true"></canvas>
    <div class="hero-fallback" aria-hidden="true"></div>
    <Skyline />

    <div class="hero-top mono">
      <span>Wayne Tower · Roof</span>
      <span data-clock aria-label="Time since the project began" data-start={PROJECT_START}>DAY 0 · 00:00:00</span>
    </div>

    <div class="hero-body wrap">
      <Emblem size={56} class="hero-emblem" />
      <h1 class="serif hero-title" data-hero-title>
        <span class="ht-line"><span>How does an</span></span>
        <span class="ht-line"><span>ordinary man become</span></span>
        <span class="ht-line"><span><em>Bruce Wayne?</em></span></span>
      </h1>
      <p class="hero-sub" data-hero-fade>
        Project Wayne is a public record of one attempt. Four years, no powers, only the work, told as a descent from the tower to the cave.
      </p>
      <div class="hero-cta" data-hero-fade>
        <a class="btn btn--solid" href="#manifesto" data-scroll>Enter the project <span class="arrow">↓</span></a>
        <a class="enter-link" href="/cave"><span class="code">B3</span> Straight to the cave</a>
      </div>
    </div>

    <dl class="hero-stats wrap" data-hero-fade>
      {
        headline.map((h) => (
          <div>
            <dt class="eyebrow">{h.label}</dt>
            <dd>
              <span class="display hs-n" data-count={h.value} data-delay="1.6">{h.value.toLocaleString('en-US')}</span>
              <span class="hs-sub mono">{h.sub}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ═════════════ MANIFESTO ═════════════ -->
  <section class="manifesto" id="manifesto" data-fl="atrium" data-pose="manifesto" data-manifesto>
    <div class="mf-sticky wrap">
      <p class="eyebrow">The manifesto</p>
      <div class="mf-lines">
        {manifesto.map((l, i) => <p class="serif mf-line" data-mf-line={i}>{l}</p>)}
      </div>
      <p class="mf-long" data-mf-long>{manifestoLong}</p>
      <div class="mf-progress" aria-hidden="true"><span data-mf-bar></span></div>
    </div>
  </section>

  <!-- ═════════════ L30 · THE RECORD ═════════════ -->
  <section class="floor tease" id="record" data-fl="record" data-pose="hidden">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">L30</span>
        <h2 class="serif h-xl" data-split>The Record</h2>
        <p class="eyebrow">Boardroom · four years, in the order they happened</p>
      </header>

      <ol class="yrows">
        {
          keyByYear.map((y) => (
            <li data-reveal>
              <a href={`/record#year-${y.n}`} class="yrow">
                <span class="yr-n display">0{y.n}</span>
                <span class="yr-meta">
                  <span class="eyebrow">{y.span}</span>
                  <span class="serif yr-title">{y.title}</span>
                </span>
                <span class="yr-key">{y.key.slice(0, 2).map((k) => <span>{k}</span>)}</span>
                <span class="yr-go mono" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="tease-foot" data-reveal>
        <a class="btn" href="/record">Open the full record <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═════════════ L12 · THE BLUEPRINT ═════════════ -->
  <section class="floor tease blue" id="blueprint" data-fl="blueprint" data-pose="hidden">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">L12</span>
        <h2 class="serif h-xl" data-split>The Blueprint</h2>
        <p class="eyebrow">Applied Sciences · a step-by-step guide to a real-life Bruce Wayne</p>
      </header>

      <div class="blue-grid">
        <div class="fire" data-reveal>
          <p class="eyebrow">Target by age 30</p>
          <p class="display fire-n">$<span data-count="1250000">1,250,000</span></p>
          <p class="fire-sub">Financial independence, retire early. Already a fifth of the way there.</p>
          <div class="fire-bar" aria-hidden="true"><span data-fire-bar></span></div>
          <p class="mono fire-bar-l"><span>$0</span><span>1/5 reached</span><span>$1.25M</span></p>
        </div>

        <div class="phases">
          {
            phases.map((p) => (
              <article class="phase" data-reveal>
                <span class="phase-n mono">Phase 0{p.n}</span>
                <h3 class="serif h-md">{p.name}</h3>
                <p class="phase-tag eyebrow">{p.tag}</p>
                <p class="phase-text">{p.text}</p>
              </article>
            ))
          }
          <p class="bp-note" data-reveal>
            <span class="mono">{blueprintNote.date}</span>
            {blueprintNote.text}
          </p>
        </div>
      </div>

      <div class="tease-foot" data-reveal>
        <a class="btn" href="/blueprint">Walk the blueprint <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═════════════ G · THE ARCHIVE ═════════════ -->
  <section class="floor tease arch" id="archive" data-fl="archive" data-pose="hidden">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">G</span>
        <h2 class="serif h-lg" data-split>Who built the blueprint</h2>
        <p class="eyebrow">Wayne Manor · influences, in his words</p>
      </header>
    </div>
    <div class="marquee" aria-label="Influences">
      <div class="marquee-track">
        {
          marquee.map((m) => (
            <span class="mq-item">
              <span class="serif">{m.name}</span>
              <span class="mono">{m.why}</span>
            </span>
          ))
        }
      </div>
    </div>
    <div class="wrap">
      <div class="tease-foot" data-reveal>
        <a class="btn" href="/archive">Open the archive <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═════════════ DESCENT ═════════════ -->
  <section class="descent" data-fl="cases" data-pose="hidden" data-descent>
    <div class="descent-stick">
      <span class="rail rail--l" aria-hidden="true" data-rail></span>
      <span class="rail rail--r" aria-hidden="true" data-rail></span>
      <div class="d-door d-door--l" aria-hidden="true" data-d-door></div>
      <div class="d-door d-door--r" aria-hidden="true" data-d-door></div>

      <div class="d-ui">
        <p class="eyebrow d-eb">Below the lobby there is a second building</p>
        <div class="reel" aria-hidden="true">
          <div class="reel-strip" data-reel>
            <span>L12</span><span>G</span><span>B1</span>
          </div>
        </div>
        <p class="serif descent-line" data-descent-line>Take the stairs down.</p>
        <p class="d-arrow mono" data-d-arrow aria-hidden="true">▼ going down</p>
      </div>

      <div class="d-arrive" aria-hidden="true" data-d-arrive>
        <span class="mono">B1</span>
        <span class="display">Case Files</span>
      </div>
    </div>
  </section>

  <!-- ═════════════ B1 · CASE FILES ═════════════ -->
  <section class="floor tease cases" id="cases" data-fl="cases" data-pose="cases">
    <div class="wrap">
      <header class="floor-head">
        <span class="code">B1</span>
        <h2 class="display h-xl" data-split>Case Files</h2>
        <p class="eyebrow">Evidence Room · {cases.length} entries: journal, Monk Modes, video scripts</p>
      </header>

      <div class="folders" data-folders>
        {
          featured.map((c, i) => (
            <a href={`/cases#case-${c.no}`} class="folder" data-folder style={`--i:${i}`}>
              <span class="folder-tab mono">CASE {String(c.no).padStart(3, '0')}</span>
              <span class="folder-date mono">{c.date}</span>
              <h3 class="display folder-title">{c.title}</h3>
              <p class="folder-ex">{c.excerpt}</p>
              {c.closed && <span class="stamp" data-stamp>Case closed</span>}
            </a>
          ))
        }
      </div>

      <div class="tease-foot" data-reveal>
        <a class="btn" href="/cases">Open all {cases.length} case files <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═════════════ B3 · THE CAVE ═════════════ -->
  <section class="floor cave-tease" id="cave" data-fl="cave" data-pose="cave">
    <canvas class="rain" data-rain aria-hidden="true"></canvas>
    <div class="torch cave-wall" data-torch>
      <div class="wrap t-dim" aria-hidden="true">
        <p class="display cw-text">{caveWall.map((l) => <span>{l}</span>)}</p>
      </div>
      <div class="wrap t-lit">
        <p class="display cw-text">{caveWall.map((l) => <span>{l}</span>)}</p>
      </div>
      <span class="cw-hint mono" aria-hidden="true">Move to shine a light</span>
    </div>

    <div class="wrap cave-body">
      <header class="floor-head">
        <span class="code">B3</span>
        <h2 class="display h-xl" data-split>The Cave</h2>
        <p class="eyebrow">The Cave · live data, straight from the spreadsheets</p>
      </header>

      <div class="pu" data-pullups>
        <div class="pu-canvas-wrap">
          <canvas data-pu-canvas aria-label="A grid of 10,000 dots. Each row of 100 is one daily set of pull-ups."></canvas>
        </div>
        <div class="pu-copy">
          <p class="eyebrow">The record attempt</p>
          <p class="display pu-n"><span data-pu-count>0</span></p>
          <p class="pu-sub">
            The 24-hour world record is closer to 9,000. The target is {pullups.record.toLocaleString('en-US')}.
            Each row is 100 pull-ups, one of his daily sets. The record is <strong>100 of them back to back</strong>.
          </p>
          <p class="mono pu-pace">Pace: {pullups.pace} · {pullups.paceNote}</p>
        </div>
      </div>

      <div class="run" data-run>
        <div class="run-head">
          <p class="eyebrow">Running log · Jul 2024 — Aug 2026</p>
          <p class="run-big display"><span data-count={running.totalMiles} data-dec="1">{running.totalMiles}</span> <small>miles</small></p>
          <p class="mono run-meta">{running.runs} runs · longest {running.longest} mi · 5-mile PR {running.fiveMilePR}</p>
        </div>
        <div class="run-bars" aria-hidden="true">
          {
            running.months.map(([m, v]) => (
              <span class="rb" style={`--h:${(v / max).toFixed(3)}`} title={`${m}: ${v} mi`}></span>
            ))
          }
        </div>
      </div>

      <div class="tease-foot" data-reveal>
        <a class="btn btn--solid" href="/cave">Enter the cave <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, floors, floorById, setHud, setTheme, initReveals, initTorch, scrollToTarget, reduce, arrived } from '../scripts/core';
    import { startHero } from '../scripts/hero';
    import { pullGrid, rain } from '../scripts/viz';

    const $ = <T extends HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];

    /* Anchors on this page */
    $$('[data-scroll]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        scrollToTarget(a.getAttribute('href')!);
      })
    );

    /* Day counter since the first journal entry */
    const clock = $('[data-clock]');
    const start = new Date(clock.dataset.start!).getTime();
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const s = Math.max(0, Math.floor((Date.now() - start) / 1000));
      const d = Math.floor(s / 86400);
      const r = s % 86400;
      clock.textContent = `DAY ${d.toLocaleString('en-US')} · ${pad(Math.floor(r / 3600))}:${pad(Math.floor((r % 3600) / 60))}:${pad(r % 60)}`;
    };
    tick();
    setInterval(tick, 1000);

    /* Hero: shader + title lit by the beam */
    const hero = $('[data-hero]');
    const { intro } = startHero($('[data-hero-gl]') as HTMLCanvasElement, hero);
    const lines = $$('.ht-line > span', hero);
    const fades = $$('[data-hero-fade]', hero);
    if (reduce) gsap.set('.hero-emblem', { opacity: 1 });
    else {
      gsap.set(lines, { yPercent: 115 });
      gsap.set(fades, { opacity: 0, y: 18 });
      arrived.then(() => {
        const tl = gsap.timeline({ delay: 0.5 });
        tl.to('.hero-emblem', { opacity: 1, duration: 1.2 }, 0)
          .to(lines, { yPercent: 0, duration: 1.5, ease: 'expo.out', stagger: 0.16 }, 0.7)
          .to(fades, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out', stagger: 0.12 }, 1.7);
      });
    }

    /* Skyline: two layers drift at different speeds while the roof scrolls away */
    if (!reduce) {
      gsap.to('[data-sky-far]', { yPercent: 8, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
      gsap.to('[data-sky-near]', { yPercent: -4, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
      hero.addEventListener('pointermove', (e) => {
        const k = e.clientX / innerWidth - 0.5;
        gsap.to('[data-sky-far]', { x: k * -14, duration: 1.2, ease: 'power3.out', overwrite: 'auto' });
        gsap.to('[data-sky-near]', { x: k * -34, duration: 1.2, ease: 'power3.out', overwrite: 'auto' });
      });
    }

    /* Manifesto: three lines light up in turn */
    const mf = $('[data-manifesto]');
    const mfLines = $$('[data-mf-line]', mf);
    if (!reduce) {
      gsap.set(mfLines, { opacity: 0.16 });
      gsap.set('[data-mf-long]', { opacity: 0 });
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: mf,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.6,
          // the 3D chest moves from its second reference shot to the third
          onUpdate: (self) => window.dispatchEvent(new CustomEvent('pw:shot', { detail: 1 + self.progress })),
        },
      });
      mfLines.forEach((l, i) => {
        tl.to(l, { opacity: 1, duration: 1 }, i * 1.1);
        if (i) tl.to(mfLines[i - 1], { opacity: 0.32, duration: 1 }, i * 1.1);
      });
      tl.to('[data-mf-long]', { opacity: 1, duration: 1 }, '>-0.2');
      tl.to('[data-mf-bar]', { scaleX: 1, duration: tl.duration(), ease: 'none' }, 0);
    }

    /* Floors drive the HUD and the theme as you scroll through the building */
    $$('[data-fl]').forEach((sec) => {
      const id = sec.dataset.fl!;
      const f = floorById(id);
      if (!f) return;
      ScrollTrigger.create({
        trigger: sec,
        start: 'top 55%',
        end: 'bottom 55%',
        onToggle: (self) => {
          if (!self.isActive) return;
          setHud(id);
          setTheme(f.theme);
          window.dispatchEvent(new CustomEvent('pw:pose', { detail: sec.dataset.pose || 'hidden' }));
        },
      });
    });

    /* Descent: an elevator ride. Doors closed, the floor reel rolls L12 → G → B1, then the doors open */
    const reel = $('[data-reel]');
    const dDoors = $$('[data-d-door]');
    const dl = dDoors[0];
    const dr = dDoors[1];
    if (reduce) {
      gsap.set(reel, { yPercent: -66.6667 });
      gsap.set([dl, dr], { scaleX: 0 });
      gsap.set('[data-d-arrive]', { opacity: 1 });
      gsap.set('[data-d-arrow]', { opacity: 0 });
    } else {
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: '[data-descent]', start: 'top top', end: 'bottom bottom', scrub: 0.5 },
      });
      gsap.set([dl, dr], { scaleX: 1 });
      tl.fromTo('[data-descent-line]', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8 }, 0)
        // the reel rolls with two stops: L12 → G, then G → B1
        .to(reel, { yPercent: -33.3333, duration: 1.1, ease: 'power2.inOut' }, 0.9)
        .to(reel, { yPercent: -66.6667, duration: 1.1, ease: 'power2.inOut' }, 2.4)
        .to('[data-rail]', { backgroundPositionY: '-1800px', duration: 3.4 }, 0.6)
        .to('[data-d-arrow]', { opacity: 0, duration: 0.3 }, 3.6)
        // arrival: the doors open on the next floor
        .to('[data-descent-line]', { opacity: 0, duration: 0.3 }, 3.7)
        .to([dl, dr], { scaleX: 0, duration: 1.1, ease: 'power3.inOut' }, 4.0)
        .to('.reel, .d-eb', { opacity: 0, duration: 0.5 }, 4.1)
        .to('[data-d-arrive]', { opacity: 1, duration: 0.7 }, 4.4)
        .to({}, { duration: 0.6 }); // hold on the open doors
    }

    /* Case folders slide into a stack */
    if (!reduce) {
      $$('[data-folder]').forEach((el, i) => {
        gsap.from(el, {
          y: 140 + i * 40,
          rotate: (i - 1) * 3,
          opacity: 0,
          duration: 1.2,
          ease: 'expo.out',
          scrollTrigger: { trigger: '[data-folders]', start: 'top 80%', once: true },
          delay: i * 0.12,
        });
      });
      $$('[data-stamp]').forEach((s) => {
        gsap.fromTo(s, { scale: 2.6, opacity: 0, rotate: -22 }, { scale: 1, opacity: 1, rotate: -9, duration: 0.45, ease: 'power4.in', scrollTrigger: { trigger: s, start: 'top 85%', once: true }, delay: 0.5 });
      });
    }

    /* FIRE bar */
    gsap.fromTo('[data-fire-bar]', { scaleX: 0 }, { scaleX: 0.2, duration: 2, ease: 'expo.out', scrollTrigger: { trigger: '[data-fire-bar]', start: 'top 90%', once: true } });

    /* Cave: torch, pull-up grid, running bars */
    initTorch($('[data-torch]'));
    $$<HTMLCanvasElement>('canvas[data-rain]').forEach((c) => rain(c));

    const grid = pullGrid($('[data-pu-canvas]') as HTMLCanvasElement);
    const puCount = $('[data-pu-count]');
    const setPu = (p: number) => {
      grid.set(p);
      puCount.textContent = grid.count.toLocaleString('en-US');
    };
    if (reduce) setPu(0.42);
    else
      ScrollTrigger.create({
        trigger: '[data-pullups]',
        start: 'top 75%',
        end: 'bottom 35%',
        scrub: 0.5,
        onUpdate: (s) => setPu(s.progress),
      });

    const rb = $$('.rb');
    if (!reduce) {
      gsap.set(rb, { scaleY: 0 });
      gsap.to(rb, { scaleY: 1, duration: 1.1, ease: 'expo.out', stagger: 0.025, scrollTrigger: { trigger: '[data-run]', start: 'top 80%', once: true } });
    }

    initReveals();
    ScrollTrigger.refresh();
  </script>
</Base>

<style>
  /* ───────── Hero ───────── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: clip;
    --bg: #07080a;
    --fg: #ece8e1;
    --muted: #8f8b83;
    --line: rgba(236, 232, 225, 0.14);
    --accent: #ffd400;
    --accent-ink: #07080a;
    color: var(--fg);
  }
  .hero-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-fallback {
    position: absolute;
    inset: 0;
    display: none;
    background: radial-gradient(ellipse 40% 90% at 50% 110%, rgba(255, 212, 0, 0.25), transparent 70%);
  }
  .hero.no-gl .hero-fallback {
    display: block;
  }
  .hero-top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    padding: calc(var(--nav-h) + 18px) calc(var(--gutter) + var(--rail)) 0 var(--gutter);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero-top span:last-child {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .hero-body {
    position: relative;
    z-index: 2;
    align-self: center;
    width: 100%;
    padding-block: 1vh;
  }
  :global(.hero-emblem) {
    color: var(--accent);
    margin-bottom: clamp(12px, 2.4vh, 24px);
    width: clamp(40px, 5.4vh, 56px);
    height: auto;
    opacity: 0;
    filter: drop-shadow(0 0 18px rgba(255, 212, 0, 0.5));
  }
  .hero-title {
    margin: 0;
    font-size: clamp(46px, min(8.2vw, 14.5vh), 150px);
    line-height: 0.93;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: transparent;
    background: radial-gradient(circle 46vmax at var(--lx, 50%) 105%, #fff 0%, rgba(255, 255, 255, 0.72) 38%, rgba(255, 255, 255, 0.22) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    text-wrap: balance;
  }
  .hero-title em {
    font-style: italic;
  }
  .ht-line {
    display: block;
    overflow: hidden;
    padding: 0.04em 0.06em 0.14em 0;
    margin-bottom: -0.1em;
  }
  .ht-line > span {
    display: block;
  }
  .hero-sub {
    max-width: 46ch;
    margin: clamp(16px, 3vh, 32px) 0 0;
    font-size: clamp(16px, 1.3vw, 20px);
    color: #c9c5bd;
  }
  .hero-cta {
    margin-top: clamp(20px, 3.4vh, 32px);
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0 auto;
    padding-bottom: clamp(18px, 3vh, 30px);
    padding-top: 10px;
    width: 100%;

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { years, comments, misses } from '../data/wayne';
const total = years.reduce((n, y) => n + y.items.length, 0);
---

<Base title="The Record · Project Wayne" floor="record" theme="bruce">
  <PageHero
    floor="record"
    eyebrow="Accomplishments made possible through Project Wayne"
    title="The Record"
    lede={`${total} things done in four years, in the order they happened. The misses are in there too.`}
  />

  <section class="years">
    {
      years.map((y) => (
        <article class="year" id={`year-${y.n}`} data-year>
          <div class="wrap year-grid">
            <header class="year-head">
              <span class="year-n display">0{y.n}</span>
              <p class="eyebrow">{y.span}</p>
              <h2 class="serif h-md">{y.title}</h2>
            </header>

            <div class="year-body">
              <span class="spine" aria-hidden="true"><span data-spine></span></span>
              <ol class="items">
                {y.items.map((it) => (
                  <li class:list={['item', { key: it.key }]} data-item>
                    <span class="item-dot" aria-hidden="true"></span>
                    <span class="item-text">{it.text}</span>
                    {it.key && <span class="item-tag mono">Milestone</span>}
                  </li>
                ))}
              </ol>
              {y.note && <p class="year-note" data-reveal>{y.note}</p>}
              {
                y.n === 3 && (
                  <aside class="margin" aria-label="Comments from readers, 2025">
                    {comments.map((c) => (
                      <blockquote class="margin-note">
                        <p>“{c.text}”</p>
                        <footer class="mono">{c.who}, {c.when}</footer>
                      </blockquote>
                    ))}
                  </aside>
                )
              }
              {
                misses.some((m) => m.year === y.n) && (
                  <ul class="misses" aria-label={`Misses in year ${y.n}`}>
                    {misses
                      .filter((m) => m.year === y.n)
                      .map((m) => (
                        <li class="miss">
                          <span class="miss-date mono">{m.date}</span>
                          <s class="miss-plan">{m.plan}</s>
                          <span class="miss-said mono">{m.said}</span>
                          <span class="miss-stamp" aria-hidden="true">Missed</span>
                        </li>
                      ))}
                  </ul>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="floor">
    <div class="wrap">
      <div class="next">
        <a class="enter-link" href="/blueprint"><span class="code">L12</span> Next floor down: the Blueprint →</a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/page';
    import { gsap, ScrollTrigger, reduce } from '../scripts/core';

    document.querySelectorAll<HTMLElement>('[data-year]').forEach((year) => {
      const spine = year.querySelector<HTMLElement>('[data-spine]')!;
      const items = [...year.querySelectorAll<HTMLElement>('[data-item]')];
      if (reduce) {
        items.forEach((i) => i.classList.add('on'));
        gsap.set(spine, { scaleY: 1 });
        return;
      }
      gsap.fromTo(spine, { scaleY: 0 }, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: year.querySelector('.items'), start: 'top 70%', end: 'bottom 60%', scrub: 0.4 } });
      items.forEach((it) => {
        ScrollTrigger.create({
          trigger: it,
          start: 'top 72%',
          onEnter: () => it.classList.add('on'),
          onLeaveBack: () => it.classList.remove('on'),
        });
      });
    });
  </script>
</Base>

<style>
  .year {
    overflow-x: clip;
    padding-block: clamp(72px, 12vh, 140px);
    border-bottom: 1px solid var(--line);
  }
  .year-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) 1.4fr;
    gap: clamp(32px, 6vw, 120px);
  }
  .year-head {
    position: sticky;
    top: 110px;
    align-self: start;
    display: grid;
    gap: 8px;
  }
  .year-n {
    font-size: clamp(120px, 20vw, 320px);
    line-height: 0.8;
    color: var(--fg);
  }
  .year-head h2 {
    margin: 10px 0 0;
  }
  .year-body {
    position: relative;
    padding-left: 44px;
  }
  .spine {
    position: absolute;
    left: 7px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: var(--line);
  }
  .spine span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(0);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(19px, 1.9vw, 28px);
    line-height: 1.2;
    color: var(--muted);
    transition: color 0.6s var(--ease-out);
  }
  .item:last-child {
    border-bottom: 0;
  }
  .item-dot {
    position: absolute;
    left: -44px;
    top: 30px;
    width: 15px;
    height: 15px;
    border: 1px solid var(--line);
    background: var(--bg);
    transition: background 0.5s, border-color 0.5s, transform 0.5s var(--ease-out);
  }
  .item.on {
    color: var(--fg);
  }
  .item.on .item-dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: rotate(45deg) scale(0.9);
  }
  .item.key {
    font-family: var(--f-serif);
    font-size: clamp(24px, 2.6vw, 40px);
  }
  .item-tag {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 11px;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid currentColor;
    padding: 3px 6px 2px;
    opacity: 0;
    transform: scale(1.6) rotate(-6deg);
    transition: opacity 0.35s 0.15s, transform 0.5s 0.15s var(--ease-out);
  }
  .item.on .item-tag {
    opacity: 1;
    transform: none;
  }
  .misses {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .miss {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 18px 120px 18px 0;
    border-top: 1px dashed var(--line);
  }
  .miss-date {
    font-size: 12px;
    color: var(--muted);
  }
  .miss-plan {
    font-size: clamp(18px, 1.7vw, 24px);
    color: var(--muted);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--stamp);
  }
  .miss-said {
    font-size: 14px;
    max-width: 58ch;
    line-height: 1.55;
  }
  .miss-stamp {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    rotate: -8deg;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 24px;
    letter-spacing: 0.04em;
    color: var(--stamp);
    border: 3px solid var(--stamp);
    padding: 2px 10px 0;
    opacity: 0.85;
  }
  .year-note {
    margin: 28px 0 0;
    padding: 16px 18px;
    background: var(--bg-2);
    border-left: 2px solid var(--accent);
    color: var(--muted);
    font-size: 15px;
  }

  .margin {
    margin: 32px 0 0 clamp(0px, 6vw, 72px);
    display: grid;
    gap: 14px;
    border-left: 1px solid var(--line);
    padding-left: 18px;
  }
  .margin-note {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .margin-note p {
    margin: 0;
  }
  .margin-note footer {
    font-size: 11px;
    margin-top: 4px;
    opacity: 0.8;
  }

  @media (max-width: 860px) {
    .year-grid {
      grid-template-columns: 1fr;
    }
    .year-head {
      position: static;
    }
    .year-n {
      font-size: 120px;
    }
    .item {
      flex-wrap: wrap;
    }
  }
</style>

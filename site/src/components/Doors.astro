---
// Full-screen elevator doors used for every floor jump, on the same page or
// across pages. Pages loaded mid-ride start with the doors shut (see the inline
// script in Base.astro) and the app opens them.
---

<div class="doors" aria-hidden="true">
  <div class="door door--l"><span class="door-seam"></span></div>
  <div class="door door--r"><span class="door-seam"></span></div>
  <div class="doors-display">
    <span class="dd-label" data-doors-label>Going down</span>
    <span class="dd-code" data-doors-code>B3</span>
    <span class="dd-name" data-doors-name>The Cave</span>
  </div>
</div>

<div class="sr-only" aria-live="polite" data-doors-live></div>

<style>
  .doors {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    visibility: hidden;
  }
  :global(html.riding) .doors,
  :global(html.doors-closed) .doors {
    visibility: visible;
    pointer-events: all;
  }

  .door {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50.5%;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 7px),
      linear-gradient(90deg, #16171a, #1f2024 50%, #141518);
    transform: scaleX(0);
  }
  .door--l {
    left: 0;
    transform-origin: left center;
    box-shadow: inset -1px 0 0 rgba(255, 212, 0, 0.35);
  }
  .door--r {
    right: 0;
    transform-origin: right center;
    box-shadow: inset 1px 0 0 rgba(255, 212, 0, 0.35);
  }
  :global(html.doors-closed) .door {
    transform: scaleX(1);
  }

  .doors-display {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: #e6e4df;
    opacity: 0;
  }
  :global(html.doors-closed) .doors-display {
    opacity: 1;
  }
  .dd-label {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8f8d88;
  }
  .dd-code {
    font-family: var(--f-mono);
    font-size: clamp(72px, 12vw, 160px);
    line-height: 1;
    color: #ffd400;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 40px rgba(255, 212, 0, 0.35);
    min-width: 3ch;
    text-align: center;
  }
  .dd-name {
    font-family: var(--f-serif);
    font-size: clamp(22px, 2.4vw, 32px);
  }
</style>

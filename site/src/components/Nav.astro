---
import Emblem from './Emblem.astro';
import { floors } from '../data/wayne';

const bruce = floors.filter((f) => f.wing === 'bruce' && f.id !== 'atrium');
const batman = floors.filter((f) => f.wing === 'batman');
---

<header class="nav" data-nav>
  <a href="/" class="brand" data-floor-link="atrium" aria-label="Project Wayne, Penthouse (home)">
    <Emblem size={26} />
    <span class="brand-name">Project Wayne</span>
  </a>

  <nav class="wings" aria-label="Spaces">
    <div class="wing wing--bruce">
      <a class="wing-label" href="/record" data-wing="bruce">Bruce Wayne</a>
      <ul>
        {
          bruce.map((f) => (
            <li>
              <a href={f.href} data-floor-link={f.id}>
                <span class="nl-code">{f.code}</span>
                <span class="nl-name">{f.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <span class="wing-div" aria-hidden="true"></span>
    <div class="wing wing--batman">
      <a class="wing-label" href="/cave" data-wing="batman">Batman</a>
      <ul>
        {
          batman.map((f) => (
            <li>
              <a href={f.href} data-floor-link={f.id}>
                <span class="nl-code">{f.code}</span>
                <span class="nl-name">{f.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="nav-tools">
    <button class="tool" data-map-open aria-label="Open the building map (M)">
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 14V4l3-2v12M5 14V6h4v8M9 14V2l5 2v10" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
      <span class="tool-t">Map</span><kbd>M</kbd>
    </button>
    <button class="tool" data-palette-open aria-label="Search the project (Command K)">
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5"></path></svg>
      <kbd>⌘K</kbd>
    </button>
    <a class="btn btn--solid nav-cta" href="#signal" data-signal-link>Light the signal</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 28px;
    padding-inline: var(--gutter);
    color: var(--fg);
    transition: transform 0.6s var(--ease-out);
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--bg) 0%, color-mix(in srgb, var(--bg) 70%, transparent) 60%, transparent);
    opacity: 0;
    transition: opacity 0.4s;
    z-index: -1;
    pointer-events: none;
  }
  :global(html.scrolled) .nav::before {
    opacity: 1;
  }
  :global(html.nav-hidden) .nav {
    transform: translateY(-100%);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--f-label);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .brand :global(.emblem) {
    color: var(--accent);
    transition: transform 0.8s var(--ease-out);
  }
  .brand:hover :global(.emblem) {
    transform: rotate(-30deg);
  }

  /* ───── Two wings ───── */
  .wings {
    display: flex;
    align-items: stretch;
    gap: 22px;
    margin-left: auto;
  }
  .wing {
    display: grid;
    gap: 2px;
  }
  .wing ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 18px;
  }
  .wing-label {
    font-family: var(--f-label);
    font-size: 13px;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s;
  }
  .wing-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .wing-label:hover {
    color: var(--accent);
  }
  .wing--bruce .wing-label::before,
  .wing--batman .wing-label::before {
    content: '';
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
  }
  .wing--bruce .wing-label::before {
    border: 1px solid var(--muted);
  }
  .wing--batman .wing-label::before {
    background: #ffd400;
  }
  .wing-div {
    width: 1px;
    background: var(--line);
    margin-block: 2px;
  }
  .wing li a {
    font-size: 13px;
    display: flex;
    align-items: baseline;
    gap: 6px;
    opacity: 0.72;
    transition: opacity 0.25s;
    position: relative;
    white-space: nowrap;
  }
  .wing li a:hover,
  .wing li a[aria-current='true'] {
    opacity: 1;
  }
  .wing li a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--accent);
  }
  .nl-code {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--accent);
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 12px;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--line);
    font-family: var(--f-label);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color 0.25s;
  }
  .tool:hover {
    border-color: var(--accent);
  }
  .tool kbd {
    font: inherit;
    opacity: 0.6;
    letter-spacing: 0;
  }
  .nav-cta {
    height: 36px;
    padding: 0 14px;
    font-size: 11px;
  }

  @media (max-width: 1360px) {
    .nl-code {
      display: none;
    }
  }
  @media (max-width: 1180px) {
    .wings {
      display: none;
    }
    .nav-tools {
      margin-left: auto;
    }
  }
  @media (max-width: 600px) {
    .brand-name,
    .nav-cta,
    .tool kbd {
      display: none;
    }
    .nav {
      gap: 12px;
    }
    .tool-t {
      display: inline;
    }
  }
</style>

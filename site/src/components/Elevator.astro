---
import { floors } from '../data/wayne';
---

<aside class="elevator" aria-label="Elevator: jump to a floor">
  <div class="elev-display" aria-hidden="true">
    <span class="elev-arrow" data-elev-arrow>▼</span>
    <span class="elev-code" data-elev-code>L42</span>
  </div>

  <ol class="elev-buttons">
    {
      floors.map((f, i) => (
        <li>
          <a href={f.href} class="elev-btn" data-floor-link={f.id} data-key={i + 1} data-code={f.code} data-level={f.level} data-name={f.name} data-theme-of={f.theme}>
            <span class="eb-code">{f.code}</span>
            <span class="eb-name">
              <span class="eb-key">{i + 1}</span>
              <span class="eb-text"><b>{f.name}</b><i>{f.fn}</i></span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="elev-shaft" aria-hidden="true"><span data-elev-car></span></div>
</aside>

<style>
  .elevator {
    position: fixed;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    z-index: 55;
    width: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    color: var(--fg);
  }

  .elev-display {
    width: 56px;
    height: 44px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-family: var(--f-mono);
    font-variant-numeric: tabular-nums;
  }
  .elev-code {
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .elev-arrow {
    font-size: 7px;
    color: var(--accent);
    opacity: 0.8;
    transition: transform 0.4s var(--ease-out);
  }
  .elev-arrow.up {
    transform: rotate(180deg);
  }

  .elev-buttons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .elev-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(6px);
    transition: border-color 0.3s, color 0.3s, box-shadow 0.4s, background 0.3s;
  }
  .elev-btn:hover {
    border-color: var(--accent);
  }
  .elev-btn[aria-current='true'] {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent), 0 0 18px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .eb-name {
    position: absolute;
    right: calc(100% + 14px);
    top: 50%;
    transform: translate(8px, -50%);
    white-space: nowrap;
    font-family: var(--f-sans);
    font-size: 13px;
    letter-spacing: 0;
    padding: 7px 10px;
    background: var(--fg);
    color: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s, transform 0.35s var(--ease-out);
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .eb-text {
    display: grid;
    line-height: 1.15;
  }
  .eb-text b {
    font-weight: 500;
  }
  .eb-text i {
    font-style: normal;
    font-family: var(--f-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .eb-key {
    font-family: var(--f-mono);
    font-size: 10px;
    border: 1px solid currentColor;
    padding: 0 4px;
    opacity: 0.6;
  }
  .elev-btn:hover .eb-name,
  .elev-btn:focus-visible .eb-name {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .elev-shaft {
    width: 1px;
    height: 90px;
    background: var(--line);
    position: relative;
  }
  .elev-shaft span {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 14px;
    background: var(--accent);
    transform: translateY(var(--car, 0px));
  }

  @media (max-width: 860px) {
    .elevator {
      top: auto;
      bottom: 0;
      right: 0;
      left: 0;
      transform: none;
      width: auto;
      height: 64px;
      flex-direction: row;
      padding: 0 10px;
      gap: 10px;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--line);
    }
    .elev-display {
      width: 52px;
      height: 40px;
      flex-shrink: 0;
    }
    .elev-buttons {
      flex-direction: row;
      flex: 1;
      justify-content: space-between;
      gap: 4px;
    }
    .elev-btn {
      width: 40px;
      height: 40px;
      font-size: 10.5px;
    }
    .eb-name,
    .elev-shaft {
      display: none;
    }
  }
</style>
